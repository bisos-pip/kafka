from bisos import b
# from bisos.b import cmndsSeed
from bisos.b import cs
from bisos.b import b_io

import json
import pathlib
from bisos.basics import pyRunAs

# import collections

from bisos.sbom import pkgsSeed  # pkgsSeed.plantWithWhich("seedSbom.cs")
from bisos.banna import tcpPorts as bannaTcpPorts

ap = pkgsSeed.aptPkg
pp = pkgsSeed.pipPkg

# Same source the webserver unit uses for its --port. The api-server's port must
# also reach the task-execution layer --- see airflowAcctEnvSetup() below.
_portNu = bannaTcpPorts.tcpPortsAssignedList.tcpPortsList['airflow'].portNu
_airflowFqdn = "airflow.here"

pkgsSeed.pkgsSeedInfo.virtenv = "/bisos/venv/py3/asc"

# AIRFLOW_HOME for the systemd-managed installation. Runtime state only (dags,
# logs, airflow.cfg, metadata DB) --- the pyvenv is pkgsSeedInfo.virtenv above.
# Must agree with what airflowAcctEnvSetup() writes to /etc/default/airflow,
# which is what the airflow-*.service units read via EnvironmentFile.
_airflowHome = "/opt/airflow"

# Metadata DB. Peer auth over the unix socket: the connection carries no user
# and no password, so PostgreSQL maps the *OS* account to the like-named role.
# That is why the role must be called airflow and why no secret appears here,
# in /etc/default/airflow, or in airflow.cfg. See airflowPostgresSetup().
_pgConnStr = "postgresql+psycopg2://@/airflow?host=/var/run/postgresql"

def airflowAcctEnvSetup():
    """Setup the airflow account and its environment. Not an apt package.

    Registered in aptPkgsList as a func-bearing pseudo-package, so sbom_csu's
    aptPkgs_update() calls this instead of apt-get install. Its gate is
    aptPkg_isInstalled("airflowAcctEnvSetup"), which can never be true --- so
    this runs on *every* sbom_fullUpdate and must stay idempotent.

    The pyvenv is pkgsSeedInfo.virtenv (/bisos/venv/py3/asc), shared with other
    bisos packages rather than per-application. Only Airflow's runtime state
    (AIRFLOW_HOME) lives under /opt/airflow.
    """
    outcome = b.subProc.WOpW(invedBy=None, log=1).bash(
        f"""
# 1. Dedicated system user -- only when absent, useradd exits 9 otherwise
id airflow >/dev/null 2>&1 || sudo useradd -r -m -s /bin/bash airflow

# 2. AIRFLOW_HOME and the dirs airflow must own. No venv here -- see docstring.
sudo mkdir -p {_airflowHome}/dags {_airflowHome}/logs
sudo chown -R airflow:airflow {_airflowHome}

# 3. tmpfiles daemon configuration for PID and socket files
echo "D /run/airflow 0755 airflow airflow -" | sudo tee /etc/tmpfiles.d/airflow.conf >/dev/null
sudo systemd-tmpfiles --create

# 4. EnvironmentFile for the airflow-*.service units. Written only when absent,
#    so hand-added overrides survive re-runs. systemd reads it as root before
#    dropping to User=airflow, so root:airflow 640 suffices: readable by the
#    service account, not writable by it.
# AIRFLOW__API__BASE_URL / AIRFLOW__CORE__EXECUTION_API_SERVER_URL are not
# optional niceties. Airflow 3 task processes reach the api-server over HTTP
# (the Task Execution API) instead of touching the DB; when BASE_URL is unset
# the task SDK falls back to http://localhost:8080. Because the port here comes
# from the bisos.banna registry rather than Airflow's default, every task then
# dies with [Errno 111] Connection refused before it starts --- while all units
# stay green and the UI serves normally.
# base_url is the address humans browse (through the nginx vhost); the execution
# URL goes straight to the api-server so task execution does not depend on nginx.
if [ ! -f /etc/default/airflow ] ; then
    printf '%s\\n%s\\n%s\\n%s\\n%s\\n' \\
        'AIRFLOW_HOME={_airflowHome}' \\
        'AIRFLOW__DATABASE__SQL_ALCHEMY_CONN={_pgConnStr}' \\
        'AIRFLOW__API__BASE_URL=http://{_airflowFqdn}' \\
        'AIRFLOW__CORE__EXECUTION_API_SERVER_URL=http://localhost:{_portNu}/execution/' \\
        '# Add any overrides or environment variables needed by your DAGs here' \\
        | sudo tee /etc/default/airflow >/dev/null
fi
sudo chown root:airflow /etc/default/airflow
sudo chmod 640 /etc/default/airflow
""")
    if outcome.isProblematic():
        b_io.eh.badOutcome(outcome)
    return outcome


def airflowPostgresSetup():
    """Provision the PostgreSQL metadata DB. Not an apt package.

    Same func-bearing pseudo-package mechanism as airflowAcctEnvSetup above:
    it runs on *every* sbom_fullUpdate and must stay idempotent.

    Ordering in aptPkgsList is load-bearing --- this must come after
    ap("postgresql") (the server has to exist) and after airflowAcctEnvSetup
    (the OS account has to exist, since peer auth maps the OS user to the
    like-named role).

    Why not SQLite: it is Airflow's default and is documented as dev/test
    only. One writer at a time, which the scheduler contends with under any
    real task concurrency.
    """
    outcome = b.subProc.WOpW(invedBy=None, log=1).bash(
        """
# 1. Cluster must be running. Debian's postgresql-common starts it at install
#    time --- except under policy-rc.d (containers), where it silently does not.
#    Version/cluster are discovered, not hardcoded, so a major-version bump of
#    the postgresql metapackage does not strand this.
sudo systemctl enable postgresql >/dev/null 2>&1 || true
read PGVER PGCLUSTER <<< "$(pg_lsclusters -h | awk 'NR==1 {print $1, $2}')"
sudo pg_ctlcluster "$PGVER" "$PGCLUSTER" start 2>/dev/null || true

# 2. LOGIN role named for the OS account -- peer auth maps one to the other.
sudo -u postgres psql -tAc "SELECT 1 FROM pg_roles WHERE rolname='airflow'" \\
    | grep -q 1 || sudo -u postgres psql -c "CREATE ROLE airflow LOGIN"

# 3. Database owned by that role, so airflow db migrate can create its schema.
sudo -u postgres psql -tAc "SELECT 1 FROM pg_database WHERE datname='airflow'" \\
    | grep -q 1 || sudo -u postgres createdb -O airflow airflow

# 4. Five airflow units each hold a SQLAlchemy pool; stock max_connections=100
#    is tight. ALTER SYSTEM needs a restart to take effect, so only do both
#    when the value is actually low --- otherwise every sbom run bounces the DB.
PGMAXCONN=$(sudo -u postgres psql -tAc "show max_connections")
if [ "$PGMAXCONN" -lt 200 ] ; then
    sudo -u postgres psql -c "ALTER SYSTEM SET max_connections = 200" >/dev/null
    sudo pg_ctlcluster "$PGVER" "$PGCLUSTER" restart
fi
""")
    if outcome.isProblematic():
        b_io.eh.badOutcome(outcome)
    return outcome


aptPkgsList = [
    ap("airflowAcctEnvSetup", func=airflowAcctEnvSetup),
    ap("python3"),                  # Airflow requires Python 3.8+
    ap("python3-pip"),              # pip for airflow installation
    ap("python3-venv"),             # venv for isolated airflow environment
    ap("build-essential"),          # C compiler needed for some Airflow deps
    ap("libpq-dev"),                # PostgreSQL client headers (for psycopg2)
    ap("libssl-dev"),               # SSL support
    ap("libffi-dev"),               # Foreign function interface (required by cryptography)
    ap("pkg-config"),               # Used by pip to locate system libraries
    ap("postgresql"),               # Metadata DB server -- must precede the setup below
    ap("airflowPostgresSetup", func=airflowPostgresSetup),
]

pipPkgsList = [
    pp("apache-airflow", ver=">=2.9.0"),
    pp("psycopg2"),                 # PostgreSQL driver for the metadata DB (sync)
    pp("asyncpg"),                  # ... and async. Airflow 3 builds an async
                                    # engine too; without this every CLI call and
                                    # unit dies with ModuleNotFoundError: asyncpg.
]

pkgsSeed.setup(
    aptPkgsList=aptPkgsList,
    pipPkgsList=pipPkgsList,
)


####+BEGIN: b:py3:cs:cmnd/classHead :cmndName "readme" :extent "verify" :comment "Describe" :parsMand "" :parsOpt "" :argsMin 0 :argsMax 0 :pyInv ""
""" #+begin_org
*  _[[elisp:(blee:menu-sel:outline:popupMenu)][±]]_ _[[elisp:(blee:menu-sel:navigation:popupMenu)][Ξ]]_ [[elisp:(outline-show-branches+toggle)][|=]] [[elisp:(bx:orgm:indirectBufOther)][|>]] *[[elisp:(blee:ppmm:org-mode-toggle)][|N]]*  CmndSvc-   [[elisp:(outline-show-subtree+toggle)][||]] <<readme>>  *Describe*  =verify= ro=cli   [[elisp:(org-cycle)][| ]]
#+end_org """
class readme(cs.Cmnd):
    cmndParamsMandatory = [ ]
    cmndParamsOptional = [ ]
    cmndArgsLen = {'Min': 0, 'Max': 0,}

    @cs.track(fnLoc=True, fnEntry=True, fnExit=True)
    def cmnd(self,
             rtInv: cs.RtInvoker,
             cmndOutcome: b.op.Outcome,
    ) -> b.op.Outcome:
        """Describe"""
        failed = b_io.eh.badOutcome
        callParamsDict = {}
        if self.invocationValidate(rtInv, cmndOutcome, callParamsDict, None).isProblematic():
            return failed(cmndOutcome)
####+END:
        descriptionStr = f"""\
** Scope: Apache Airflow -- workflow orchestration platform on Debian 12.

** What this installs:
  1) The airflow system user, {_airflowHome} (AIRFLOW_HOME) and
     /etc/default/airflow -- via the airflowAcctEnvSetup pseudo-package.
  2) System apt packages: python3, python3-pip, python3-venv, build-essential,
     libpq-dev, libssl-dev, libffi-dev, pkg-config, postgresql.
  3) pip packages: apache-airflow (>=2.9.0) and psycopg2, installed into
     {pkgsSeed.pkgsSeedInfo.virtenv}.
  4) The PostgreSQL metadata DB -- role and database both named airflow --
     via the airflowPostgresSetup pseudo-package.

** Systemd-managed setup (how this host runs it): the four airflow-*.service
   units run as User=airflow and take AIRFLOW_HOME from
   /etc/default/airflow. See airflow-cbs.pcs / cbmProc-airflow.spcs.
       airflow-sbom.pcs -i sbom_fullUpdate     # install, then materialize units
       # credentials auto-generated at:
       #   {_airflowHome}/simple_auth_manager_passwords.json.generated
       # username: admin   password: airflow-sbom.pcs -i adminPasswd

** Metadata DB: PostgreSQL, provisioned by this package (see 4 above). The
   connection string is set as AIRFLOW__DATABASE__SQL_ALCHEMY_CONN in
   /etc/default/airflow, which overrides airflow.cfg:
       {_pgConnStr}
   It carries no user and no password --- peer auth over the unix socket maps
   the airflow OS account to the airflow role. Airflow's stock SQLite backend
   is dev/test only: single-writer, and the scheduler contends with itself
   under task concurrency.

   NOTE: /etc/default/airflow is written only when absent, so on a host
   provisioned before this change the line must be added by hand.

   NOTE: the airflow-*.service units need After=/Requires=postgresql.service.
   Without it the scheduler can come up against a DB that is not listening.

** Executor is NOT set by this package --- it comes from whatever airflow.cfg
   already exists in AIRFLOW_HOME.\
"""
        print(descriptionStr)

        return cmndOutcome.set(
            opError=b.op.OpError.Success,
            opResults=None,
        )

####+BEGIN: b:py3:cs:cmnd/classHead :cmndName "adminPasswd" :extent "verify" :comment "Get admin passwd" :parsMand "" :parsOpt "" :argsMin 0 :argsMax 0 :pyInv ""
""" #+begin_org
*  _[[elisp:(blee:menu-sel:outline:popupMenu)][±]]_ _[[elisp:(blee:menu-sel:navigation:popupMenu)][Ξ]]_ [[elisp:(outline-show-branches+toggle)][|=]] [[elisp:(bx:orgm:indirectBufOther)][|>]] *[[elisp:(blee:ppmm:org-mode-toggle)][|N]]*  CmndSvc-   [[elisp:(outline-show-subtree+toggle)][||]] <<adminPasswd>>  *Get admin passwd*  =verify= ro=cli   [[elisp:(org-cycle)][| ]]
#+end_org """
class adminPasswd(cs.Cmnd):
    cmndParamsMandatory = [ ]
    cmndParamsOptional = [ ]
    cmndArgsLen = {'Min': 0, 'Max': 0,}

    @cs.track(fnLoc=True, fnEntry=True, fnExit=True)
    def cmnd(self,
             rtInv: cs.RtInvoker,
             cmndOutcome: b.op.Outcome,
    ) -> b.op.Outcome:
        """Print the auto-generated Simple Auth Manager admin password.

        The systemd airflow services run as User=airflow with
        AIRFLOW_HOME=/opt/airflow (set via EnvironmentFile=/etc/default/airflow),
        so the generated password file is owned by airflow and is not readable
        by an arbitrary invoker --- hence the read is still done as root.
        """
        failed = b_io.eh.badOutcome
        callParamsDict = {}
        if self.invocationValidate(rtInv, cmndOutcome, callParamsDict, None).isProblematic():
            return failed(cmndOutcome)

        pwFile = pathlib.Path(_airflowHome) / "simple_auth_manager_passwords.json.generated"

        contentStr = pyRunAs.as_root_readFromFile(pwFile)
        if not contentStr:
            b_io.ann.note(f"ERROR: could not read {pwFile} (has airflow been started at least once?)")
            return failed(cmndOutcome)

        try:
            passwd = json.loads(contentStr).get("admin")
        except json.JSONDecodeError:
            b_io.ann.note(f"ERROR: {pwFile} is not valid JSON")
            return failed(cmndOutcome)

        if not passwd:
            b_io.ann.note(f"ERROR: no 'admin' entry in {pwFile}")
            return failed(cmndOutcome)

        print(passwd)
        return cmndOutcome.set(
            opError=b.op.OpError.Success,
            opResults=passwd,
        )
####+END:

def examples_csu() -> b.op.Outcome:
    """Common Usage Examples for this Command-Service Unit"""

    cmnd = cs.examples.cmndEnter
    literal = cs.examples.execInsert

    airflow = pkgsSeed.pkgsSeedInfo.binPath("airflow")
    pip = pkgsSeed.pkgsSeedInfo.binPath("pip")
    python3 = pkgsSeed.pkgsSeedInfo.binPath("python3")

    cmndOutcome = b.op.Outcome()

    cs.examples.menuChapter('*Airflow Command Examples*')
    if not (resStr := b.subProc.Op(outcome=cmndOutcome, log=0).bash(
       f"""which airflow""").stdout):
        pass

    literal(f"which airflow # {resStr.strip()}")
    literal(f"{airflow} version")
    literal(f"{airflow} --help")

    cmnd('readme', comment=" # An overview short description")

    cs.examples.menuChapter('*Installation*')
    literal("airflow-sbom.pcs -i sbom_fullUpdate")

    cs.examples.menuChapter('*Airflow Home and Environment*')
    literal(f"export AIRFLOW_HOME={_airflowHome}   # as the units do, via /etc/default/airflow")
    literal("cat /etc/default/airflow   # sudo, it is root:airflow 640")
    literal("echo $AIRFLOW_HOME")
    literal(f"{airflow} config list")
    literal(f"{airflow} info")

    cs.examples.menuChapter('*Database Initialisation*')
    literal(f"{airflow} db migrate          # initialise / migrate the metadata DB")
    literal(f"{airflow} db check            # verify DB connectivity")

    cs.examples.menuChapter('*User Management*')
    literal(f"# credentials auto-generated at: {_airflowHome}/simple_auth_manager_passwords.json.generated")
    literal(f"sudo cat {_airflowHome}/simple_auth_manager_passwords.json.generated  # airflow-owned")
    cmnd('adminPasswd', comment=f" # print the auto-generated admin password (reads {_airflowHome} as root)")
    literal(f"{airflow} users list")

    cs.examples.menuChapter('*Running Airflow (standalone / local testing)*')
    literal(f"{airflow} standalone           # all-in-one: webserver + scheduler + triggerer")
    literal(f"{airflow} webserver --port 8080")
    literal(f"{airflow} scheduler")

    cs.examples.menuChapter('*DAGs*')
    literal(f"{airflow} dags list")
    literal(f"{airflow} dags trigger <dag_id>")
    literal(f"{airflow} dags pause <dag_id>")
    literal(f"{airflow} dags unpause <dag_id>")
    literal(f"{airflow} dags show <dag_id>")

    cs.examples.menuChapter('*Tasks*')
    literal(f"{airflow} tasks list <dag_id>")
    literal(f"{airflow} tasks test <dag_id> <task_id> <execution_date>")

    cs.examples.menuChapter('*Connections and Variables*')
    literal(f"{airflow} connections list")
    literal(f"{airflow} variables list")

    cs.examples.menuChapter('*Verify Installation*')
    literal(f"{pip} show apache-airflow")
    literal(f"{airflow} version")
    literal(f"{python3} -c \"import airflow; print(airflow.__version__)\"")

    cs.examples.menuChapter('*End-Of Airflow Command Examples*')
    return cmndOutcome
